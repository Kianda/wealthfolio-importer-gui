# Copy to .env and fill in your values. .env is gitignored.

# Docker image to pull and run (also used by build/build.sh for push).
IMAGE=kianda/wf-importer-gui:latest

# Optional: pre-fill the password field in the Streamlit UI.
# WF_PASSWORD=

# Optional: override the Wealthfolio internal URL at runtime.
# WF_BASE_URL=http://wealthfolio:8088

# Optional: path to a custom config file (default: wf-config.yml).
# WF_CONFIG=wf-config.yml
